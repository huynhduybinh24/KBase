PGVECTOR_DB=kbase
PGVECTOR_USER=kbase
PGVECTOR_PASSWORD=kbase-dev-password
PGVECTOR_PORT=5433

DB_USERNAME=kbase
DB_PASSWORD=kbase-dev-password

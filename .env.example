CORS_ALLOWED_ORIGINS=http://localhost:5173
DOCUMENT_MAX_FILE_SIZE_BYTES=52428800
PROFILE_AVATAR_MAX_FILE_SIZE_BYTES=2097152
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MAX_HISTORY_MESSAGES=10
RAG_MAX_CONTEXT_CHUNKS=10
RAG_MAX_CONTEXT_CHARS=20000

EMBEDDING_PROVIDER=dev
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=kbase-dev-hash-v1
EMBEDDING_DIMENSION=128

LLM_PROVIDER=dev
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=kbase-dev-context-v1
